{
  "routes": [
    {
      "src": "/",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|[Pp]review|WhatsApp|facebookexternalhit|Facebot|Slack|Discord|Skype|Viber|Signal|vkShare|LinkedIn|Pinterest|[Ee]mbedly|Iframely|Mastodon|Teams).*" },
        { "type": "header", "key": "accept-language", "value": "de.*" }
      ],
      "dest": "/de/index.html"
    },
    {
      "src": "/",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|[Pp]review|WhatsApp|facebookexternalhit|Facebot|Slack|Discord|Skype|Viber|Signal|vkShare|LinkedIn|Pinterest|[Ee]mbedly|Iframely|Mastodon|Teams).*" },
        { "type": "header", "key": "accept-language", "value": "(ru|uk|be).*" }
      ],
      "dest": "/ru/index.html"
    },
    { "handle": "filesystem" }
  ]
}
